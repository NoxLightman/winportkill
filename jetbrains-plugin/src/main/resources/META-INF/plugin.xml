<idea-plugin>
    <id>dev.winportkill.jetbrains</id>
    <name>WinPortKill</name>
    <vendor url="https://github.com/NoxLightman/winport-killer">NoxLightman</vendor>

    <description><![CDATA[
        Inspect local Windows x64 listening ports and processes inside JetBrains IDEs.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="WinPortKill"
                anchor="right"
                canCloseContents="false"
                factoryClass="dev.winportkill.jetbrains.toolwindow.WinPortKillToolWindowFactory"/>
    </extensions>
</idea-plugin>
